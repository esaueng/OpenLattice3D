{
  "name": "openlattice3d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-20",
  "routes": [
    {
      "pattern": "openlattice3d.com",
      "custom_domain": true
    },
    {
      "pattern": "lattice.esau.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "run_worker_first": [
      "/health",
      "/healthz",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "previews": { "vars": { "GLIMPSE_BASIC_ENABLED": "false", "GLIMPSE_USAGE_ENABLED": "false" } },
  "services": [{ "binding": "GLIMPSE", "service": "glimpse", "entrypoint": "OpenLattice3DIngest" }],
  "vars": {
    "GLIMPSE_BASIC_ENABLED": "true",
    "GLIMPSE_USAGE_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "GLIMPSE_USAGE_LIMITER",
      "namespace_id": "2026101503",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
