{
  "name": "openlattice3d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-20",
  "routes": [
    {
      "pattern": "openlattice3d.com",
      "custom_domain": true
    },
    {
      "pattern": "lattice.esau.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/health", "/healthz"]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
